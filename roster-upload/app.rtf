async function supabaseFetch(path, \{ method="GET", body=null \} = \{\}) \{\
  const headers = \{\
    "apikey": SUPABASE_ANON,\
    "authorization": `Bearer $\{SUPABASE_ANON\}`,\
  \};\
  if (body) headers["content-type"] = "application/json";\
  const res = await fetch(`$\{SUPABASE_URL\}$\{path\}`, \{ method, headers, body: body ? JSON.stringify(body) : undefined \});\
  const text = await res.text();\
  let json;\
  try \{ json = JSON.parse(text); \} catch \{ json = text; \}\
  if (!res.ok) throw new Error(typeof json === "string" ? json : (json.message || "Request failed"));\
  return json;\
\}\
